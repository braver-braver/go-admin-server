DATABASE_URL=postgres://admin:admin@localhost:5432/admin?sslmode=disable
LISTEN_ADDR=:8080
# Set both on first start to create the protected recovery administrator.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=系统管理员
SESSION_TTL=8h
COOKIE_NAME=session
COOKIE_SECURE=true
ALLOWED_ORIGINS=
TRUST_PROXY_HEADERS=false
UPLOAD_DIR=./data/uploads
LOGIN_RATE=6s
LOGIN_BURST=10
MIGRATE_ON_START=true
